# SpendWise Frontend Environment Configuration
# Copy this file to .env or .env.local

# AWS Serverless HTTP API Endpoint
# Leave empty to run in local sample/dev mode (using rich mock ledger data)
# When configured, frontend connects directly to AWS API Gateway HTTP API
VITE_API_BASE_URL="https://example.execute-api.ap-south-1.amazonaws.com/dev"

# Amazon Cognito Authentication (Public SPA configuration)
VITE_COGNITO_USER_POOL_ID="ap-south-1_exampleId"
VITE_COGNITO_CLIENT_ID="exampleclientid1234567890"
VITE_AWS_REGION="ap-south-1"

# Development & App Hosting URL
APP_URL="http://localhost:3000"
