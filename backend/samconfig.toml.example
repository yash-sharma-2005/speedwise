# SpendWise AWS SAM Deployment Configuration Example
# Copy to samconfig.toml and customize for your AWS environment:
#   cp samconfig.toml.example samconfig.toml

version = 0.1

[default]
[default.global.parameters]
stack_name = "spendwise-backend-dev"

[default.build.parameters]
cached = true
parallel = true

[default.validate.parameters]
lint = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = true
resolve_s3 = true
s3_prefix = "spendwise-backend"
region = "ap-south-1"
parameter_overrides = [
  "Stage=\"dev\"",
  "CorsAllowedOrigin=\"*\""
]
image_repositories = []

[default.package.parameters]
resolve_s3 = true

[default.sync.parameters]
watch = true

[default.local_start_api.parameters]
warm_containers = "EAGER"

[default.local_start_lambda.parameters]
warm_containers = "EAGER"
