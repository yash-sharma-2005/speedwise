# SpendWise Backend Environment Variables Example
# Copy to .env for local development with local AWS credentials / DynamoDB Local

NODE_ENV=development
STAGE=dev
AWS_REGION=ap-south-1

# CORS Configuration (Set to frontend URL in production, e.g. https://spendwise.app)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# DynamoDB Table Names (Provisioned automatically by AWS SAM template.yaml)
USERS_TABLE=spendwise-users-dev
TRANSACTIONS_TABLE=spendwise-transactions-dev
ACCOUNTS_TABLE=spendwise-accounts-dev
BUDGETS_TABLE=spendwise-budgets-dev
INVESTMENTS_TABLE=spendwise-investments-dev
LOANS_TABLE=spendwise-loans-dev
LOAN_REPAYMENTS_TABLE=spendwise-loan-repayments-dev
IMPORT_BATCHES_TABLE=spendwise-import-batches-dev
TRANSACTION_RULES_TABLE=spendwise-transaction-rules-dev
FILE_METADATA_TABLE=spendwise-file-metadata-dev

# Amazon S3 Bucket
STORAGE_BUCKET_NAME=spendwise-storage-YOUR_ACCOUNT_ID-ap-south-1-dev

# Amazon Cognito Configuration
COGNITO_USER_POOL_ID=ap-south-1_exampleId
COGNITO_CLIENT_ID=exampleclientid1234567890

# Optional Local DynamoDB / LocalStack Endpoints (Leave blank for AWS cloud)
# DYNAMODB_ENDPOINT=http://localhost:8000
# S3_ENDPOINT=http://localhost:4566
